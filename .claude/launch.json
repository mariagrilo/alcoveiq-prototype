{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "AlcoveIQ Prototype",
      "runtimeExecutable": "/opt/homebrew/bin/node",
      "runtimeArgs": ["-e", "const h=require('http'),fs=require('fs'),p=require('path');h.createServer((q,r)=>{let f=p.join('/Users/mariagrilo/Documents/AlcoveIQ',q.url==='/'?'index.html':q.url);fs.readFile(f,(e,d)=>{if(e){r.writeHead(404);r.end('Not found')}else{const m={'html':'text/html','js':'text/javascript','css':'text/css'};r.writeHead(200,{'Content-Type':m[f.split('.').pop()]||'text/plain'});r.end(d)}})}).listen(3000,()=>{})"],
      "port": 3000
    }
  ]
}
